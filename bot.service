[Unit]
Description=Gemini Telegram Slide Generator Bot (24/7 Service)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/slide_generator_bot
ExecStart=/root/slide_generator_bot/.venv/bin/python bot.py
Restart=always
RestartSec=5
EnvironmentFile=/root/slide_generator_bot/.env

# Xavfsizlik va resurs sozlamalari
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
